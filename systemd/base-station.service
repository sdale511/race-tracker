# Static reference example, not meant to be copied by hand - install-base-
# service.sh (repo root) generates this same unit and installs it. Shown
# here without an explicit REGATTAUP_REGATTA_ID - the default: this base
# picks up regatta-id.txt if present, otherwise auto-selects the closest
# active/future regatta to today the first time it starts (see
# baseStation.js's pickClosestRegatta). Pass an id to install-base-
# service.sh instead to pin one deliberately, e.g.
# `sudo ./install-base-service.sh 6a44a2531e401d60c28afcd8`.
#
# User/WorkingDirectory below are placeholders - install-base-service.sh
# fills these in with whoever ran it and wherever the checkout actually
# lives, since (unlike the boat units) a base station isn't pinned to one
# fixed path/user across every machine it might run on.
[Unit]
Description=Race Tracker Base Station
After=network.target

[Service]
Type=simple
User=jycadmin
WorkingDirectory=/home/jycadmin/race-tracker
Environment=GPS_LOG=0
ExecStart=/usr/bin/node src/baseStation.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
