# Static reference example, not meant to be copied by hand - install-boat-
# service.sh (repo root) generates this same unit with BOAT_ID actually set
# for this Pi, then installs it. Kept here mainly to show what that script
# produces.
[Unit]
Description=Race Tracker Boat Agent
After=network.target

[Service]
Type=simple
User=jycadmin
WorkingDirectory=/home/jycadmin/race-tracker
Environment=BOAT_ID=1
Environment=GPS_LOG=0
ExecStart=/usr/bin/node src/boatAgent.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
