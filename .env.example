# Copy to .env (already git-ignored) and fill in real values. .env is loaded
# automatically by config.js - see the "Redis track storage" section in
# README.md for details.

# Selects a Redis connection preset in config.js: "local" (default) or
# "production". Host/port for each preset live in config.js; only
# credentials belong here.
REDIS_ENV=production

# Redis Cloud ACL username - defaults to "default" if unset.
REDIS_USERNAME=default

# Required when REDIS_ENV=production. Never commit a real value.
REDIS_PASSWORD=

# Set to 1 if your Redis database requires TLS (this project's production
# database currently does not).
REDIS_TLS=
